# Per-account environment for one MT5 account ("Account A").
# Copy to e.g. ~/.mt5-accountA.env, fill in real values, then:
#   set -a; source ~/.mt5-accountA.env; set +a
# Never commit real credentials.

# --- which bridge/terminal this account uses -----------------------------
MT5LINUX_PORT=18812
MT5_WINEPREFIX=$HOME/Library/Application Support/net.metaquotes.wine.metatrader5

# --- credentials ----------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your_password_here
MT5_SERVER=YourBroker-Demo

# Optional: Windows-style path to this account's terminal64.exe
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
