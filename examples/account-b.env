# Per-account environment for a SECOND MT5 account ("Account B").
# Note the DIFFERENT port and a DIFFERENT Wine prefix — each account needs its
# own bridge (unique port) driving its own terminal (unique prefix).
# Copy to e.g. ~/.mt5-accountB.env, fill in real values, then:
#   set -a; source ~/.mt5-accountB.env; set +a
# Never commit real credentials.

# --- which bridge/terminal this account uses -----------------------------
MT5LINUX_PORT=18813
MT5_WINEPREFIX=$HOME/.mt5-accountB

# --- credentials ----------------------------------------------------------
MT5_LOGIN=87654321
MT5_PASSWORD=your_other_password_here
MT5_SERVER=YourBroker-Live

# Optional: Windows-style path to this account's terminal64.exe
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
